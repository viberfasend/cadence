<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sync talks to Supabase over HTTPS (ADR 0002). The app is fully usable without it: signed
         out there is no network traffic at all. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".CadenceApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cadence">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Cadence"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- App Actions voice capture (#46) — see res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            The target of a widget row's completion circle. taskAffinity="" keeps it out of the
            app's own back stack — ticking a task off a widget must not resume or reorder the
            app — and the remaining three attributes keep an activity that never draws from
            leaving any trace in Recents or in history.
        -->
        <activity
            android:name=".widget.WidgetToggleActivity"
            android:exported="false"
            android:theme="@style/Theme.Cadence.Invisible"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!--
            Hands one attachment blob to a viewer as a content:// uri, since a file under filesDir
            is unreadable to every other app and a file:// uri throws since Android 7. Not
            exported: only this app may ask it for a uri, and the grant travels with the intent
            that carries one.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.attachments"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/attachment_paths" />
        </provider>

        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminders.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
            Every widget receiver below is android:exported="false", which looks wrong and is not:
            it is what Google's own Glance manifest example specifies. An APPWIDGET_UPDATE is
            delivered by the AppWidget framework to the provider it is addressed to rather than
            broadcast to whoever declares a filter for it, so the receiver needs no export — and
            exporting one would let any app on the device drive Cadence's widget updates.

            The Android 12 rule these receivers do have to satisfy is that a component carrying an
            intent-filter states `exported` *explicitly*; it does not require the value to be true.
        -->
        <receiver
            android:name=".widget.CadenceTodayWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CadenceInboxWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/inbox_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CadenceNextTaskWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_task_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CadenceQuickAddWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>
    </application>

</manifest>
