<?xml version="1.0" encoding="utf-8"?>
<!--
    Glance requires an `initialLayout` — plain RemoteViews shown for the one frame before the
    real Glance composition takes over. Never seen for more than an instant, so it stays a bare
    placeholder rather than trying to preview real content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_placeholder_background">

    <ProgressBar
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

</FrameLayout>
