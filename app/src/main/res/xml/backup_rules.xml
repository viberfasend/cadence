<?xml version="1.0" encoding="utf-8"?>
<!--
    Full-backup-content rules for pre-Android-12 (API < 31), which ignores dataExtractionRules
    and reads this file instead — minSdk 26 means both must exist and say the same thing.

    Having any <include> switches this into an allow-list — everything else, attachments/
    included, is already left out by omission. An explicit <exclude domain="file"
    path="attachments/"> on top of that is what the FullBackupContent lint check rejects: the
    path was never included in the first place, so there is nothing for it to exclude.

    See: https://developer.android.com/guide/topics/data/autobackup
    -->
<full-backup-content>
    <include domain="database" path="cadence.db" />
    <include domain="sharedpref" path="." />
</full-backup-content>
