-- Named taskRow, not task, so the generated row class does not collide with the domain Task.
CREATE TABLE taskRow (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    notes TEXT,
    priority INTEGER NOT NULL,
    -- The project this task is filed under, or null for the Inbox. Deliberately not a REFERENCES
    -- clause — see the note above `updateRow`.
    projectId TEXT,
    -- The task this one is a step of, or null for a task that stands on its own. Nesting is one
    -- level deep, enforced by the repository, not by this column.
    parentId TEXT,
    -- The occurrence whose completion inserted this row. Deliberately no REFERENCES clause: the
    -- row it names may be deleted long before this one, and a link gone stale is harmless — ids
    -- are never reused, so it can only ever fail to match.
    spawnedFromId TEXT,
    -- Epoch day, or null for "no due date".
    dueDate INTEGER,
    -- Second of day, or null when the task is due on a day but not at a time.
    dueTime INTEGER,
    reminderTime INTEGER,
    -- Epoch millis of completion, or null while open.
    completedAt INTEGER,
    createdAt INTEGER NOT NULL,
    sortOrder INTEGER NOT NULL,
    -- Packed `v1;key=value;...` — see RecurrenceCodec.
    recurrence TEXT,
    -- Last write, local or merged in. The merge engine resolves conflicts by this.
    updatedAt INTEGER NOT NULL,
    -- Tombstone: set instead of a hard delete, so one device's delete reaches the other rather
    -- than reading as "a row I have never heard of" and being helpfully re-created
    -- (docs/adr/0002-supabase-sync.md, decision 4). Every read below filters these out; only the
    -- sync push and the 90-day sweep look at them.
    deletedAt INTEGER,
    -- The section of `projectId` this task is grouped under, or null for the project's ungrouped
    -- band. Only meaningful next to `projectId`, so moving a task to another project clears it.
    --
    -- **Last on purpose, out of order with every other column.** `3.sqm` adds it with
    -- `ALTER TABLE … ADD COLUMN`, which SQLite can only append, and the queries below are
    -- `SELECT *` — a fresh database that declared it after `projectId` would hand the mapper its
    -- columns in a different order than a migrated one. Any column added from here on goes here
    -- too, at the end, for the same reason — `tagIds` below is the first one to obey it.
    sectionId TEXT,
    -- The tags on this task, packed comma-separated by `TagIdsCodec`, or null for none. A
    -- packed column rather than a join table on purpose — see the note on `Task.tagIds`.
    -- Appended after `sectionId` because `4.sqm` adds it the only way SQLite can.
    tagIds TEXT
);

CREATE INDEX idx_task_project ON taskRow(projectId);
CREATE INDEX idx_task_section ON taskRow(sectionId);
CREATE INDEX idx_task_parent ON taskRow(parentId);
CREATE INDEX idx_task_spawned_from ON taskRow(spawnedFromId);
CREATE INDEX idx_task_due ON taskRow(dueDate);
CREATE INDEX idx_task_completed ON taskRow(completedAt);
CREATE INDEX idx_task_sort ON taskRow(sortOrder);
-- What the push reads: everything written since the watermark. It runs on every sync round and
-- was a full table scan without this.
CREATE INDEX idx_task_updated ON taskRow(updatedAt);

selectAll:
SELECT * FROM taskRow WHERE deletedAt IS NULL;

selectById:
SELECT * FROM taskRow WHERE id = :id AND deletedAt IS NULL;

-- The merge's view of a row. It has to see tombstones: comparing an incoming edit against a
-- local tombstone is the whole point, and `selectById` hiding it would let a stale edit win.
selectByIdIncludingDeleted:
SELECT * FROM taskRow WHERE id = :id;

selectSubtasksOf:
SELECT * FROM taskRow WHERE parentId = :parentId AND deletedAt IS NULL ORDER BY sortOrder, id;

-- ── Writing a row ──────────────────────────────────────────────────────────────────
--
-- Three statements rather than the one `INSERT OR REPLACE` that used to stand here. SQLite
-- implements REPLACE as *delete the conflicting row, then insert*, this table used to declare
-- `parentId … ON DELETE CASCADE`, and both shells open the database with
-- `PRAGMA foreign_keys = ON` — so saving an edit to a task deleted its whole checklist and every
-- attachment on it. See the same note in `Project.sq` for why the cascades left the schema.
--
-- SQLite before 3.24 has no `ON CONFLICT … DO UPDATE` and minSdk 26 ships 3.19, so an upsert is
-- an UPDATE followed by an `INSERT OR IGNORE`, run as a pair inside one transaction.

updateRow:
UPDATE taskRow SET title = :title, notes = :notes, priority = :priority, projectId = :projectId,
    sectionId = :sectionId, tagIds = :tagIds, parentId = :parentId,
    spawnedFromId = :spawnedFromId,
    dueDate = :dueDate, dueTime = :dueTime,
    reminderTime = :reminderTime, completedAt = :completedAt, createdAt = :createdAt,
    sortOrder = :sortOrder, recurrence = :recurrence, updatedAt = :updatedAt,
    deletedAt = :deletedAt
WHERE id = :id;

-- The merge's half of the pair: last writer wins, decided in SQL rather than by reading the row
-- back first. Ties keep what is stored, the same rule the server's trigger applies.
updateIfOlder:
UPDATE taskRow SET title = :title, notes = :notes, priority = :priority, projectId = :projectId,
    sectionId = :sectionId, tagIds = :tagIds, parentId = :parentId,
    spawnedFromId = :spawnedFromId,
    dueDate = :dueDate, dueTime = :dueTime,
    reminderTime = :reminderTime, completedAt = :completedAt, createdAt = :createdAt,
    sortOrder = :sortOrder, recurrence = :recurrence, updatedAt = :updatedAt,
    deletedAt = :deletedAt
WHERE id = :id AND updatedAt < :updatedAt;

-- Importing a file only: an incoming record lands on a row this device has tombstoned, and the
-- file is what the person asked for, so it comes back whatever the timestamps say. Stamped with
-- the import's own clock rather than the file's — the row has to be newer than the tombstone the
-- server still holds, or the next pull deletes it straight back. Sync never calls this.
reviveIfDeleted:
UPDATE taskRow SET title = :title, notes = :notes, priority = :priority, projectId = :projectId,
    sectionId = :sectionId, tagIds = :tagIds, parentId = :parentId,
    spawnedFromId = :spawnedFromId,
    dueDate = :dueDate, dueTime = :dueTime,
    reminderTime = :reminderTime, completedAt = :completedAt, createdAt = :createdAt,
    sortOrder = :sortOrder, recurrence = :recurrence, updatedAt = :revivedAt, deletedAt = NULL
WHERE id = :id AND deletedAt IS NOT NULL;

insertIfAbsent:
INSERT OR IGNORE INTO taskRow(
    id, title, notes, priority, projectId, sectionId, tagIds, parentId, spawnedFromId,
    dueDate, dueTime, reminderTime, completedAt, createdAt, sortOrder, recurrence,
    updatedAt, deletedAt
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Closes a task only if it is still open. Follow with `changes` to learn whether this call was
-- the one that did it — the guard the whole idempotent-completion rule depends on.
-- A tombstoned row must report 0 here, not 1: it is gone as far as every list is concerned, and
-- reporting 1 would have the caller schedule a successor for a task nobody can see.
completeIfOpen:
UPDATE taskRow SET completedAt = :completedAt, updatedAt = :completedAt
WHERE id = :id AND completedAt IS NULL AND deletedAt IS NULL;

-- The mirror of completeIfOpen: reopens a done task. Follow with `changes`.
reopenIfDone:
UPDATE taskRow SET completedAt = NULL, updatedAt = :updatedAt
WHERE id = :id AND completedAt IS NOT NULL AND deletedAt IS NULL;

-- SQLite's own count of rows touched by the statement just run on this connection —
-- completeIfOpen and reopenIfDone read this back to report whether *this* call changed the row.
changes:
SELECT changes();

-- The occurrences a completion inserted that nobody has ticked off yet.
selectOpenSuccessorsOf:
SELECT id FROM taskRow WHERE spawnedFromId = :id AND completedAt IS NULL AND deletedAt IS NULL;

-- Deleting a task takes its subtasks with it — a step without its task has no meaning.
-- `deletedAt IS NULL` in the WHERE keeps this idempotent: deleting twice must not restamp the
-- tombstone, or the second delete would win a merge it has no business winning.
tombstoneWithSubtasks:
UPDATE taskRow SET deletedAt = :at, updatedAt = :at
WHERE (id = :id OR parentId = :id) AND deletedAt IS NULL;

-- The Settings danger zone: every task at once. Same tombstone as every other delete — a wipe
-- has to travel to the other devices, or the next pull hands the whole list straight back.
-- `deletedAt IS NULL` keeps it idempotent for the same reason `tombstoneWithSubtasks` has it.
tombstoneAll:
UPDATE taskRow SET deletedAt = :at, updatedAt = :at WHERE deletedAt IS NULL;

-- Sync's two views, and the only ones that see tombstones.
-- What to push: everything written since the last successful push, deletions included.
selectChangedSince:
SELECT * FROM taskRow WHERE updatedAt > :since ORDER BY updatedAt;

-- A fresh device has pushed nothing, so it pushes everything it has.
selectAllIncludingDeleted:
SELECT * FROM taskRow ORDER BY updatedAt;

-- The 90-day sweep (ADR 0001 decision 6, kept by ADR 0002). Only ever run after a push that
-- succeeded: collecting a tombstone this device has not yet handed over loses the deletion.
collectTombstones:
DELETE FROM taskRow WHERE deletedAt IS NOT NULL AND deletedAt < :before;

-- ── Manual order ───────────────────────────────────────────────────────────────────
--
-- `sortOrder` has been in this table since the first schema and nothing ever wrote it: every row
-- was inserted with 0, so `SortMode.MANUAL` ordered by id. Dragging a row is what writes it.
--
-- `sortOrder != :sortOrder` is not an optimisation, it is what keeps a reorder from waking the
-- other device for nothing: renumbering a ten-row list after moving one row rewrites the rows
-- that actually moved, and the push carries only those. It also keeps `updatedAt` honest — a row
-- whose position did not change was not written.
updateSortOrder:
UPDATE taskRow SET sortOrder = :sortOrder, updatedAt = :updatedAt
WHERE id = :id AND deletedAt IS NULL AND sortOrder != :sortOrder;

-- Where a new task goes: last in its list, not first. `IS` rather than `=` so the Inbox
-- (`projectId IS NULL`) is a bucket like any other — `= NULL` matches nothing in SQLite.
-- Subtasks are excluded: a checklist is its own list, numbered by the repository's `addSubtask`.
--
-- `COALESCE(…, -1)` rather than a bare MAX so the result is NOT NULL and SQLDelight generates a
-- plain `Long` instead of wrapping a nullable column in a one-field row class. -1 is the empty
-- bucket, and the caller's `+ 1` lands the first row at 0 without a branch.
maxSortOrderIn:
SELECT COALESCE(MAX(sortOrder), -1) FROM taskRow
WHERE deletedAt IS NULL AND parentId IS NULL AND projectId IS :projectId;
