-- Everything sync has to remember between rounds, in one row that always exists.
--
-- It lives in the app's own database rather than in the settings file because the session and the
-- cursor have to stay consistent with the rows they describe (ADR 0002, decision 7): a settings
-- file restored from a backup, or written while a merge was half done, would leave a device
-- claiming to have pulled rows it does not have.

CREATE TABLE syncStateRow (
    -- One row, forever. The CHECK is the schema saying so rather than the code remembering to.
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 1),
    -- supabase-kt's serialised session, or null when signed out. Persisted here instead of in
    -- java.util.prefs, which is where its default JVM storage would put it.
    session TEXT,
    -- The server's clock, as ISO-8601, not ours: `server_updated_at` of the newest row pulled.
    -- Kept as text so no precision is lost against Postgres's microseconds.
    taskCursor TEXT,
    projectCursor TEXT,
    -- Local epoch millis. Everything written after this is what the next push sends, tombstones
    -- included; 0 on a fresh device, which therefore pushes everything it has.
    pushWatermark INTEGER NOT NULL DEFAULT 0,
    -- When the last round finished, for the Settings line and for the once-a-day tombstone sweep.
    lastSyncedAt INTEGER,
    lastSweepAt INTEGER
);

-- The row is inserted with the table, so every read can assume it is there.
INSERT INTO syncStateRow(id, session, taskCursor, projectCursor, pushWatermark, lastSyncedAt, lastSweepAt)
VALUES (1, NULL, NULL, NULL, 0, NULL, NULL);

select:
SELECT * FROM syncStateRow WHERE id = 1;

setSession:
UPDATE syncStateRow SET session = :session WHERE id = 1;

setTaskCursor:
UPDATE syncStateRow SET taskCursor = :cursor WHERE id = 1;

setProjectCursor:
UPDATE syncStateRow SET projectCursor = :cursor WHERE id = 1;

setPushWatermark:
UPDATE syncStateRow SET pushWatermark = :watermark WHERE id = 1;

setLastSyncedAt:
UPDATE syncStateRow SET lastSyncedAt = :at WHERE id = 1;

setLastSweepAt:
UPDATE syncStateRow SET lastSweepAt = :at WHERE id = 1;

-- Signing out drops the session *and* everything derived from a server this device may never
-- talk to again. It deliberately touches no task or project row: the local database is the
-- source of truth and signing out is not a delete.
clearSync:
UPDATE syncStateRow
SET session = NULL, taskCursor = NULL, projectCursor = NULL, pushWatermark = 0,
    lastSyncedAt = NULL, lastSweepAt = NULL
WHERE id = 1;
