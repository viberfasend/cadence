-- Named projectRow, not project, so the generated row class does not collide with the domain
-- Project.
CREATE TABLE projectRow (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    colorHex TEXT NOT NULL,
    -- The project this one is nested under. Nesting is one level deep, enforced by the repository,
    -- not this table — and deliberately *not* a REFERENCES clause (see the note above `updateRow`).
    parentId TEXT,
    sortOrder INTEGER NOT NULL,
    -- Last write, local or merged in. The merge engine resolves conflicts by this.
    updatedAt INTEGER NOT NULL,
    -- Tombstone — see taskRow.deletedAt.
    deletedAt INTEGER
);

CREATE INDEX idx_project_parent ON projectRow(parentId);
CREATE INDEX idx_project_sort ON projectRow(sortOrder);
-- What the push reads: everything written since the watermark. It runs on every sync round and
-- was a full table scan without this.
CREATE INDEX idx_project_updated ON projectRow(updatedAt);

selectById:
SELECT * FROM projectRow WHERE id = :id AND deletedAt IS NULL;

-- See taskRow.selectByIdIncludingDeleted: the merge must be able to see a local tombstone.
selectByIdIncludingDeleted:
SELECT * FROM projectRow WHERE id = :id;

selectAll:
SELECT * FROM projectRow WHERE deletedAt IS NULL ORDER BY sortOrder;

-- ── Writing a row ──────────────────────────────────────────────────────────────────
--
-- Three statements rather than the one `INSERT OR REPLACE` that used to stand here, because
-- SQLite implements REPLACE as *delete the conflicting row, then insert* — and this table used
-- to carry `parentId … REFERENCES projectRow(id) ON DELETE CASCADE` while both shells open the
-- database with `PRAGMA foreign_keys = ON`. Rewriting a project therefore deleted every
-- subproject under it and emptied it of tasks (`taskRow.projectId` was `ON DELETE SET NULL`),
-- which is what made a re-imported backup come back without its subprojects. The cascades are
-- gone from the schema now — a local-first app whose rows arrive out of order cannot enforce
-- referential integrity in SQLite, which is why the Postgres mirror has never had a foreign key
-- either (docs/adr/0002-supabase-sync.md) — and no write deletes a row it is about to insert.
--
-- SQLite before 3.24 has no `ON CONFLICT … DO UPDATE`, and minSdk 26 ships 3.19, so an upsert is
-- an UPDATE followed by an `INSERT OR IGNORE`: the update does nothing when the row is absent,
-- the insert does nothing when it is present, and the store runs the pair in one transaction.
-- `INSERT OR IGNORE` skips a *uniqueness* conflict only — a real error still surfaces.

updateRow:
UPDATE projectRow SET name = :name, colorHex = :colorHex, parentId = :parentId,
    sortOrder = :sortOrder, updatedAt = :updatedAt, deletedAt = :deletedAt
WHERE id = :id;

-- The merge's half of the pair: last writer wins, decided in SQL. It replaces a
-- `selectByIdIncludingDeleted` per record — a pulled page of a thousand rows cost a thousand
-- reads before this, for a comparison the WHERE clause makes for free. Ties keep what is stored,
-- the same rule the server's trigger applies.
updateIfOlder:
UPDATE projectRow SET name = :name, colorHex = :colorHex, parentId = :parentId,
    sortOrder = :sortOrder, updatedAt = :updatedAt, deletedAt = :deletedAt
WHERE id = :id AND updatedAt < :updatedAt;

-- Importing a file only — see the same query in `Task.sq`. A person pointing at a file is asking
-- for its contents, so a record that lands on a tombstone here comes back, stamped with the
-- import's clock so the revival outlives the tombstone the server still holds.
reviveIfDeleted:
UPDATE projectRow SET name = :name, colorHex = :colorHex, parentId = :parentId,
    sortOrder = :sortOrder, updatedAt = :revivedAt, deletedAt = NULL
WHERE id = :id AND deletedAt IS NOT NULL;

insertIfAbsent:
INSERT OR IGNORE INTO projectRow(id, name, colorHex, parentId, sortOrder, updatedAt, deletedAt)
VALUES (?, ?, ?, ?, ?, ?, ?);

-- Everything filed under the project, including its subprojects — nesting is one level.
-- A tombstoned subproject is not "under" anything any more, so it is excluded on both sides.
selectTaskIdsIn:
SELECT id FROM taskRow
WHERE deletedAt IS NULL
  AND (projectId = :id
       OR projectId IN (SELECT id FROM projectRow WHERE parentId = :id AND deletedAt IS NULL));

-- `sectionId` goes with the project: a section belongs to one project, so a task landing in the
-- Inbox cannot keep a heading nothing answers to.
moveTasksToInbox:
UPDATE taskRow SET projectId = NULL, sectionId = NULL, updatedAt = :updatedAt
WHERE deletedAt IS NULL
  AND (projectId = :id
       OR projectId IN (SELECT id FROM projectRow WHERE parentId = :id AND deletedAt IS NULL));

-- Tasks of a deleted project, when the user chose to delete them with it. Subtasks come along:
-- their parent is in the same project, so `parentId IN (...)` would be redundant here.
tombstoneTasksIn:
UPDATE taskRow SET deletedAt = :at, updatedAt = :at
WHERE deletedAt IS NULL
  AND (projectId = :id
       OR projectId IN (SELECT id FROM projectRow WHERE parentId = :id AND deletedAt IS NULL));

-- A section is part of the project, not of the work: whichever way the tasks go, the headings go
-- with the project. Run before `tombstoneWithChildrenRows` for the same reason the two statements
-- above are — it reads `parentId = :id` against rows that one is about to tombstone.
tombstoneSectionsIn:
UPDATE sectionRow SET deletedAt = :at, updatedAt = :at
WHERE deletedAt IS NULL
  AND (projectId = :id
       OR projectId IN (SELECT id FROM projectRow WHERE parentId = :id AND deletedAt IS NULL));

tombstoneWithChildrenRows:
UPDATE projectRow SET deletedAt = :at, updatedAt = :at
WHERE (id = :id OR parentId = :id) AND deletedAt IS NULL;

-- The Settings danger zone — see `taskRow.tombstoneAll`. Tasks are wiped by that statement, not
-- by this one, so this never has to reason about which project a task was filed under.
tombstoneAllRows:
UPDATE projectRow SET deletedAt = :at, updatedAt = :at WHERE deletedAt IS NULL;

-- Sync's two views, and the only ones that see tombstones.
selectChangedSince:
SELECT * FROM projectRow WHERE updatedAt > :since ORDER BY updatedAt;

selectAllIncludingDeleted:
SELECT * FROM projectRow ORDER BY updatedAt;

collectTombstones:
DELETE FROM projectRow WHERE deletedAt IS NOT NULL AND deletedAt < :before;

-- ── Manual order ───────────────────────────────────────────────────────────────────
-- See the same pair in `Task.sq` for why the guard is in the WHERE. The bucket here is "the
-- projects under this parent", with the root list as `parentId IS NULL`.
updateSortOrder:
UPDATE projectRow SET sortOrder = :sortOrder, updatedAt = :updatedAt
WHERE id = :id AND deletedAt IS NULL AND sortOrder != :sortOrder;

-- See `taskRow.maxSortOrderIn` for why this is COALESCEd to a NOT NULL -1.
maxSortOrderUnder:
SELECT COALESCE(MAX(sortOrder), -1) FROM projectRow
WHERE deletedAt IS NULL AND parentId IS :parentId;
